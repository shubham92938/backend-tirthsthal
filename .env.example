# ── Tirthstal Backend Environment ──
# Local dev: cp .env.example .env  and fill in values.
# Hosting (Render / Railway): set these in the dashboard instead — do not commit .env.

# ── Server ──
# Hosts inject PORT automatically; local default is 3000 (frontend expects http://localhost:3000/api)
PORT=3000
NODE_ENV=development

# ── Database (REQUIRED) ──
# Local:  mongodb://127.0.0.1:27017/tirthstal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tirthstal?retryWrites=true&w=majority
# Atlas → Network Access must allow the hosting provider (0.0.0.0/0 for testing).
MONGO_URI=mongodb://127.0.0.1:27017/tirthstal

# ── Auth (REQUIRED) ──
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE=7d

# ── CORS / frontend URLs ──
# Comma-separated list of frontend origins (no paths, trailing slashes are stripped).
# The production Netlify site is always allowed; localhost is allowed when NODE_ENV != production.
CLIENT_URL=https://tirthsthalweb.netlify.app
# Single URL used to build password-reset links. Falls back to the first CLIENT_URL entry.
FRONTEND_URL=https://tirthsthalweb.netlify.app
# Allow Netlify deploy previews (https://<branch>--tirthsthalweb.netlify.app)
ALLOW_NETLIFY_PREVIEWS=false

# ── Optional ──
# Override DNS to 1.1.1.1/8.8.8.8 — only if Atlas SRV lookups fail on your network
DNS_OVERRIDE=false

# ── Email (password reset + contact form) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
# Where contact-form messages are emailed (defaults to EMAIL_USER)
# CONTACT_RECIPIENT=team@tirthstal.example
